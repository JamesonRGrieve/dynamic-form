{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-order"],
  "rules": {
    "order/properties-alphabetical-order": true,
    "no-descending-specificity": null,
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "variants",
          "responsive",
          "screen",
          "config",
          "theme",
          "source",
          "utility",
          "custom-variant",
          "reference"
        ]
      }
    ],
    "selector-class-pattern": null,
    "custom-property-pattern": null
  },
  "ignoreFiles": ["dist/**", "storybook-static/**", "node_modules/**", "src/app/**"]
}
