{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noRedeclare": "off",
        "noExplicitAny": "warn"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    },
    "includes": [
      "src/**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/*.test.ts",
      "!**/*.test.tsx",
      "!**/*.spec.ts",
      "!**/*.spec.tsx",
      "!**/*.stories.ts",
      "!**/*.stories.tsx"
    ]
  },
  "formatter": {
    "enabled": false
  }
}
