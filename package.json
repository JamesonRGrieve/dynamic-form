{
  "name": "@jgrieve/forms",
  "version": "1.0.0-alpha.1",
  "description": "Schema-driven dynamic form generation for React.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-fix": "pnpm lint:fix",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:ratchet:update": "node scripts/lint-ratchet.mjs --update",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prettier": "pnpm format",
    "prettier-fix": "pnpm format:fix",
    "fix": "pnpm format:fix && pnpm lint:fix",
    "typecheck": "tsc --noEmit",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "typecheck:ratchet:update": "node scripts/typecheck-ratchet.mjs --update",
    "symmetry": "node scripts/coverage-symmetry.mjs",
    "symmetry:ratchet": "node scripts/symmetry-ratchet.mjs",
    "symmetry:ratchet:update": "node scripts/symmetry-ratchet.mjs --update",
    "js-coverage": "node scripts/js-coverage.mjs",
    "js-coverage:ratchet": "node scripts/js-coverage-ratchet.mjs",
    "js-coverage:ratchet:update": "node scripts/js-coverage-ratchet.mjs --update",
    "knip": "knip",
    "knip:ratchet": "node scripts/knip-ratchet.mjs",
    "knip:ratchet:update": "node scripts/knip-ratchet.mjs --update",
    "deps:check": "depcruise --config .dependency-cruiser.cjs --output-type err src",
    "deps:ratchet": "node scripts/depcruise-ratchet.mjs",
    "deps:ratchet:update": "node scripts/depcruise-ratchet.mjs --update",
    "type-coverage": "type-coverage --strict --no-detail",
    "type-coverage:ratchet": "node scripts/type-coverage-ratchet.mjs",
    "type-coverage:ratchet:update": "node scripts/type-coverage-ratchet.mjs --update",
    "strict:ratchet": "node scripts/strict-ratchet.mjs",
    "strict:ratchet:update": "node scripts/strict-ratchet.mjs --update",
    "test:typecheck:ratchet": "node scripts/test-typecheck-ratchet.mjs",
    "test:typecheck:ratchet:update": "node scripts/test-typecheck-ratchet.mjs --update",
    "important:ratchet": "node scripts/important-ratchet.mjs",
    "important:ratchet:update": "node scripts/important-ratchet.mjs --update",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix --allow-empty-input",
    "css:ratchet": "node scripts/css-ratchet.mjs",
    "css:ratchet:update": "node scripts/css-ratchet.mjs --update",
    "lockfile:validate": "node scripts/lockfile-validate.mjs",
    "biome:lint": "biome lint src/",
    "biome:ratchet": "node scripts/biome-ratchet.mjs",
    "biome:ratchet:update": "node scripts/biome-ratchet.mjs --update",
    "animation:coverage": "node scripts/animation-coverage.mjs",
    "animation:ratchet": "node scripts/animation-ratchet.mjs",
    "animation:ratchet:update": "node scripts/animation-ratchet.mjs --update",
    "theme:coverage": "node scripts/theme-coverage.mjs",
    "theme:ratchet": "node scripts/theme-ratchet.mjs",
    "theme:ratchet:update": "node scripts/theme-ratchet.mjs --update",
    "size-limit": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "sh ./scripts/run-storybook-playwright-tests.sh",
    "compile": "tsc -p tsconfig.compile.json",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "precommit": "pnpm compile && pnpm check",
    "dev": "pnpm storybook",
    "storybook": "storybook dev -p 6006",
    "storybook-build": "storybook build",
    "storybook-deploy": "storybook build && gh-pages -d storybook-static",
    "build-storybook": "storybook build",
    "check": "pnpm lint:ratchet && pnpm format && pnpm typecheck:ratchet && pnpm symmetry:ratchet && pnpm js-coverage:ratchet && pnpm knip:ratchet && pnpm deps:ratchet && pnpm type-coverage:ratchet && pnpm strict:ratchet && pnpm test:typecheck:ratchet && pnpm important:ratchet && pnpm css:ratchet && pnpm biome:ratchet && pnpm animation:ratchet && pnpm theme:ratchet && pnpm size-limit && pnpm lockfile:validate && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesonRGrieve/dynamic-form.git"
  },
  "keywords": [
    "react",
    "nextjs",
    "components"
  ],
  "author": "Jameson R Grieve",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/JamesonRGrieve/dynamic-form/issues"
  },
  "homepage": "http://jamesonrgrieve.github.io/dynamic-form",
  "files": [
    "dist"
  ],
  "_moduleAliases": {
    "@": "."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind.config.js": "./dist/tailwind.config.js",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "timezones-list": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.8.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.38.0",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "size-limit": "^14.1.0",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "type-coverage": "^2.30.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {}
  }
}
